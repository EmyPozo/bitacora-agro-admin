<div class="encabezado">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1 small">
      <li class="breadcrumb-item"><a href="/admin/<%= cfg.slug %>"><%= cfg.titulo %></a></li>
      <li class="breadcrumb-item active"><%= id ? 'Editar' : (cfg.femenino ? 'Nueva' : 'Nuevo') %></li>
    </ol></nav>
    <h1 class="h3 mb-0"><%= titulo.charAt(0).toUpperCase() + titulo.slice(1) %></h1>
  </div>
</div>

<div class="card form-card">
  <div class="card-body p-3 p-md-4">
    <% if (Object.keys(errores).length) { %>
      <div class="alert alert-danger d-flex gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
          <strong>No se guardó.</strong> El servidor encontró datos que corregir.
          <% if (errores._general) { %><div><%= errores._general %></div><% } %>
        </div>
      </div>
    <% } %>

    <form method="post" action="<%= accion %>" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="row g-3">
        <% cfg.campos.forEach(function (c) {
             const err = errores[c.name];
             const valor = valores[c.name] === undefined || valores[c.name] === null ? '' : valores[c.name];
             const cls = 'form-control' + (err ? ' is-invalid' : '');
             const ancho = (c.tipo === 'checkbox' || c.name === 'descripcion') ? 'col-12' : 'col-md-6'; %>
          <div class="<%= ancho %>">
            <% if (c.tipo === 'checkbox') { %>
              <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" role="switch" id="<%= c.name %>" name="<%= c.name %>" value="1" <%= valor ? 'checked' : '' %>>
                <label class="form-check-label" for="<%= c.name %>"><%= c.label %></label>
              </div>
              <% if (c.ayuda) { %><div class="form-text"><%= c.ayuda %></div><% } %>
            <% } else { %>
              <label class="form-label" for="<%= c.name %>">
                <%= c.label %><% if (c.requerido && !(c.tipo === 'password' && id)) { %><span class="text-danger"> *</span><% } %>
                <% if (c.sensible) { %><span class="badge text-bg-warning ms-1"><i class="bi bi-shield-lock"></i> Dato sensible</span><% } %>
              </label>

              <% if (c.tipo === 'select') { %>
                <select class="form-select<%= err ? ' is-invalid' : '' %>" id="<%= c.name %>" name="<%= c.name %>" <%= c.requerido ? 'required' : '' %>>
                  <option value=""><%= c.requerido ? 'Selecciona...' : '— Ninguno —' %></option>
                  <% c.opciones.forEach(function (o) { %>
                    <option value="<%= o.valor %>" <%= String(valor) === String(o.valor) ? 'selected' : '' %>><%= o.etiqueta %></option>
                  <% }) %>
                </select>

              <% } else if (c.tipo === 'select-fk') { %>
                <select class="form-select<%= err ? ' is-invalid' : '' %>" id="<%= c.name %>" name="<%= c.name %>" <%= c.requerido ? 'required' : '' %>>
                  <option value=""><%= c.requerido ? 'Selecciona...' : '— Ninguno —' %></option>
                  <% (opciones[c.name] || []).forEach(function (o) { %>
                    <option value="<%= o.valor %>" <%= String(valor) === String(o.valor) ? 'selected' : '' %>><%= o.etiqueta %></option>
                  <% }) %>
                </select>

              <% } else if (c.tipo === 'select-dep') { %>
                <select class="form-select<%= err ? ' is-invalid' : '' %>" id="<%= c.name %>" name="<%= c.name %>" <%= c.requerido ? 'required' : '' %>
                        data-dep-url="<%= c.url %>" data-parent="<%= c.dependeDe %>" data-selected="<%= valor %>">
                  <option value=""><%= c.requerido ? 'Selecciona...' : '— Ninguno —' %></option>
                  <% (opciones[c.name] || []).forEach(function (o) { %>
                    <option value="<%= o.valor %>" <%= String(valor) === String(o.valor) ? 'selected' : '' %>><%= o.etiqueta %></option>
                  <% }) %>
                </select>
                <div class="form-text" data-estado-para="<%= c.name %>">Se cargan según la selección anterior.</div>

              <% } else { %>
                <input class="<%= cls %>" id="<%= c.name %>" name="<%= c.name %>"
                       type="<%= c.tipo === 'number' ? 'text' : c.tipo %>"
                       <% if (c.tipo !== 'password') { %>value="<%= valor %>"<% } %>
                       <% if (c.maxLen) { %>maxlength="<%= c.maxLen %>"<% } %>
                       <% if (c.min !== undefined) { %>min="<%= c.min %>"<% } %>
                       <% if (c.max !== undefined) { %>max="<%= c.max %>"<% } %>
                       <% if (c.tipo === 'number') { %>inputmode="<%= c.decimal ? 'decimal' : 'numeric' %>"<% } %>
                       <% if (c.tipo === 'password') { %>autocomplete="new-password"<% } %>
                       <%= c.requerido && !(c.tipo === 'password' && id) ? 'required' : '' %>>
              <% } %>

              <% if (err) { %><div class="invalid-feedback d-block"><%= err %></div><% } %>
              <% if (c.ayuda && !err) { %><div class="form-text"><%= c.ayuda %></div><% } %>
            <% } %>
          </div>
        <% }) %>
      </div>

      <hr class="my-4">
      <div class="d-flex flex-column-reverse flex-sm-row gap-2 justify-content-end">
        <a class="btn btn-light" href="/admin/<%= cfg.slug %>">Cancelar</a>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i> <%= id ? 'Guardar cambios' : 'Guardar' %></button>
      </div>
    </form>
  </div>
</div>
