<div class="encabezado">
  <div>
    <h1 class="h3 mb-1"><i class="bi <%= cfg.icono %> me-2 text-success"></i><%= cfg.titulo %></h1>
    <p class="text-muted mb-0"><%= filas.length %> registro<%= filas.length === 1 ? '' : 's' %><%= q ? ' para «' + q + '»' : '' %></p>
  </div>
  <a class="btn btn-primary" href="/admin/<%= cfg.slug %>/nuevo"><i class="bi bi-plus-lg me-1"></i> <%= cfg.femenino ? 'Nueva' : 'Nuevo' %> <%= cfg.singular.toLowerCase() %></a>
</div>

<div class="card">
  <div class="card-body border-bottom">
    <form method="get" action="/admin/<%= cfg.slug %>" class="row g-2">
      <div class="col">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="search" class="form-control" name="q" value="<%= q %>" placeholder="Buscar..." maxlength="60" aria-label="Buscar">
        </div>
      </div>
      <div class="col-auto d-flex gap-2">
        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        <% if (q) { %><a class="btn btn-link" href="/admin/<%= cfg.slug %>">Limpiar</a><% } %>
      </div>
    </form>
  </div>

  <% if (filas.length === 0) { %>
    <div class="vacio">
      <i class="bi bi-inbox"></i>
      <p class="mb-0"><%= q ? 'No hay resultados para tu búsqueda.' : 'Todavía no hay registros.' %></p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <% cfg.columnas.forEach(function (c) { %><th><%= c.label %></th><% }) %>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% filas.forEach(function (f) { %>
            <tr>
              <% cfg.columnas.forEach(function (c) {
                   const texto = c.formato ? c.formato(f) : f[c.campo];
                   const color = c.badge ? c.badge(f) : null; %>
                <td data-label="<%= c.label %>">
                  <% if (color) { %><span class="badge text-bg-<%= color %>"><%= texto %></span>
                  <% } else { %><%= texto %><% } %>
                </td>
              <% }) %>
              <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" href="/admin/<%= cfg.slug %>/<%= f.id %>/editar" title="Editar"><i class="bi bi-pencil"></i><span class="d-none d-md-inline ms-1">Editar</span></a>
                <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                        data-bs-toggle="modal" data-bs-target="#modalEliminar"
                        data-action="/admin/<%= cfg.slug %>/<%= f.id %>/eliminar"
                        data-nombre="<%= cfg.etiquetaFila ? cfg.etiquetaFila(f) : f.nombre %>" title="Eliminar">
                  <i class="bi bi-trash"></i><span class="d-none d-md-inline ms-1">Eliminar</span>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarTitulo" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" id="formEliminar">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="modal-header">
        <h2 class="modal-title h5" id="modalEliminarTitulo">Eliminar <%= cfg.singular.toLowerCase() %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        ¿Seguro que quieres eliminar <strong id="nombreEliminar"></strong>? Esta acción no se puede deshacer.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
      </div>
    </form>
  </div>
</div>
