<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo ? titulo + ' · ' : '' %>BitácoraAgro</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232E7D4F'/%3E%3Cpath d='M16 25V13M16 13c0-4 3-7 8-7 0 5-3 8-8 7zM16 18c0-3-2-5-6-5 0 4 2 6 6 5z' stroke='white' stroke-width='2' fill='none' stroke-linecap='round'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<%
  const activo = function (it) { return it.exacto ? ruta === it.href : ruta.indexOf(it.href) === 0; };
  const esAdmin = user && user.rol === 'ADMINISTRADOR';
  const homeUser = user ? ({ ADMINISTRADOR: '/admin', PRODUCTOR: '/productor', COMPRADOR: '/comprador' })[user.rol] : '/';
  const rolTxt = user ? ({ ADMINISTRADOR: 'Administración', PRODUCTOR: 'Productor', COMPRADOR: 'Comprador' })[user.rol] : '';
  const modo = publico ? 'publico' : (!user ? 'simple' : (esAdmin ? 'admin' : 'app'));
%>
<body class="modo-<%= modo %>">

<% if (modo === 'simple') { %>
  <main class="login-pagina"><%- body %></main>

<% } else if (modo === 'publico') { %>
  <header class="app-nav publico-nav">
    <div class="contenedor d-flex align-items-center justify-content-between py-2">
      <a href="/" class="marca-simple"><span class="marca-icono"><i class="bi bi-flower1"></i></span><strong>BitácoraAgro</strong></a>
      <div class="d-flex align-items-center gap-2">
        <% if (user) { %>
          <a class="btn btn-sm btn-outline-success" href="<%= homeUser %>"><i class="bi bi-speedometer2 me-1"></i> Mi panel</a>
        <% } else { %>
          <a class="btn btn-sm btn-link text-success text-decoration-none fw-semibold" href="/login">Iniciar sesión</a>
          <a class="btn btn-sm btn-primary" href="/registro">Registrarse</a>
        <% } %>
      </div>
    </div>
  </header>
  <main class="publico">
    <% if (flash) { %><div class="contenedor pt-3"><div class="alert alert-<%= flash.tipo %> alert-dismissible fade show mb-0" role="alert"><%= flash.msg %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div></div><% } %>
    <%- body %>
  </main>
  <footer class="publico-pie text-center small text-muted py-4">BitácoraAgro · Trazabilidad agrícola para pequeños productores</footer>

<% } else if (modo === 'app') { %>
  <!-- Productor / Comprador: barra superior (como en los wireframes) -->
  <nav class="navbar navbar-expand-md app-nav">
    <div class="contenedor d-flex flex-wrap align-items-center w-100">
      <a class="marca-simple me-3" href="<%= homeUser %>"><span class="marca-icono"><i class="bi bi-flower1"></i></span><strong>BitácoraAgro</strong></a>
      <button class="navbar-toggler border-0 ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navApp" aria-controls="navApp" aria-label="Abrir menú">
        <i class="bi bi-list fs-3"></i>
      </button>
      <div class="collapse navbar-collapse" id="navApp">
        <ul class="navbar-nav me-auto">
          <% menu.forEach(function (g) { g.items.forEach(function (it) { %>
            <li class="nav-item"><a class="nav-link <%= activo(it) ? 'active' : '' %>" href="<%= it.href %>"><i class="bi <%= it.icono %> me-1"></i><%= it.titulo %></a></li>
          <% }) }) %>
        </ul>
        <div class="dropdown ms-md-auto mt-2 mt-md-0">
          <button class="btn btn-light border-0 d-flex align-items-center gap-2 px-2" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar avatar-sm"><%= user.nombre.charAt(0).toUpperCase() %></span>
            <span class="lh-1 text-start d-md-none d-lg-block"><span class="d-block fw-semibold small"><%= user.nombre %></span><small class="text-muted"><%= rolTxt %></small></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text small text-muted"><%= user.correo %></span></li>
            <li><hr class="dropdown-divider"></li>
            <li><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button></form></li>
          </ul>
        </div>
      </div>
    </div>
  </nav>
  <main class="contenedor app-contenido">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.tipo %> alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
        <i class="bi <%= flash.tipo === 'success' ? 'bi-check-circle-fill' : (flash.tipo === 'danger' ? 'bi-exclamation-octagon-fill' : 'bi-exclamation-triangle-fill') %>"></i>
        <div class="flex-grow-1"><%= flash.msg %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
      </div>
    <% } %>
    <%- body %>
  </main>

<% } else { %>
  <!-- Administrador: menú lateral (fijo en pantallas grandes, deslizable en móvil) -->
  <header class="topbar d-lg-none">
    <button class="btn btn-light btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-label="Abrir menú">
      <i class="bi bi-list fs-5"></i>
    </button>
    <span class="fw-semibold"><i class="bi bi-flower1 me-1"></i> BitácoraAgro</span>
    <span class="topbar-espacio"></span>
  </header>

  <nav class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="menuLateral" aria-label="Menú principal">
    <div class="offcanvas-header d-lg-none">
      <span class="text-white fw-semibold">Menú</span>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#menuLateral" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
      <a href="/admin" class="marca">
        <span class="marca-icono"><i class="bi bi-flower1"></i></span>
        <span><strong>BitácoraAgro</strong><small>Administración</small></span>
      </a>

      <ul class="nav flex-column menu">
        <% menu.forEach(function (g) { %>
          <% if (g.titulo) { %><li class="menu-grupo"><%= g.titulo %></li><% } %>
          <% g.items.forEach(function (it) { %>
            <li><a class="nav-link <%= activo(it) ? 'active' : '' %>" href="<%= it.href %>"><i class="bi <%= it.icono %>"></i> <%= it.titulo %></a></li>
          <% }) %>
        <% }) %>
      </ul>

      <div class="usuario-caja mt-auto">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="avatar"><%= user.nombre.charAt(0).toUpperCase() %></span>
          <div class="lh-sm overflow-hidden">
            <div class="text-white text-truncate fw-semibold"><%= user.nombre %></div>
            <small class="text-white-50 text-truncate d-block"><%= user.correo %></small>
          </div>
        </div>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-outline-light btn-sm w-100" type="submit"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</button>
        </form>
      </div>
    </div>
  </nav>

  <main class="contenido">
    <div class="contenido-interno">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.tipo %> alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
          <i class="bi <%= flash.tipo === 'success' ? 'bi-check-circle-fill' : (flash.tipo === 'danger' ? 'bi-exclamation-octagon-fill' : 'bi-exclamation-triangle-fill') %>"></i>
          <div class="flex-grow-1"><%= flash.msg %></div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% } %>
      <%- body %>
    </div>
  </main>
<% } %>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
