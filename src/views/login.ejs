<div class="login-tarjeta card shadow-sm border-0">
  <div class="card-body p-4 p-sm-5">
    <div class="text-center mb-4">
      <span class="marca-icono marca-icono-lg"><i class="bi bi-flower1"></i></span>
      <h1 class="h4 mt-3 mb-1">BitácoraAgro</h1>
      <p class="text-muted mb-0">Panel de administración</p>
    </div>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.tipo %> py-2 small"><%= flash.msg %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger py-2 small d-flex gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><span><%= error %></span></div>
    <% } %>

    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="mb-3">
        <label class="form-label" for="correo">Correo electrónico</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-envelope"></i></span>
          <input class="form-control" type="email" id="correo" name="correo" value="<%= correo %>" required autofocus autocomplete="username">
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="password">Contraseña</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-lock"></i></span>
          <input class="form-control" type="password" id="password" name="password" required autocomplete="current-password">
        </div>
      </div>
      <button class="btn btn-primary w-100 py-2" type="submit">Ingresar</button>
    </form>
  </div>
</div>
