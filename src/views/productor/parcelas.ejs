<div class="encabezado">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-map me-2 text-success"></i>Mis parcelas</h1>
    <p class="text-muted mb-0">Los terrenos donde siembras. Cada lote se crea dentro de una de tus parcelas.</p>
  </div>
  <a class="btn btn-primary" href="/productor/parcelas/nueva"><i class="bi bi-plus-lg me-1"></i> Nueva parcela</a>
</div>

<div class="card">
  <% if (!parcelas.length) { %>
    <div class="vacio"><i class="bi bi-map"></i><p class="mb-2">Todavía no tienes parcelas.</p><a class="btn btn-sm btn-primary" href="/productor/parcelas/nueva">Crear mi primera parcela</a></div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Nombre</th><th>Ubicación</th><th>Hectáreas</th><th>Lotes</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
          <% parcelas.forEach(function (p) { %>
            <tr>
              <td class="fw-semibold"><%= p.nombre %></td>
              <td><%= p.ubicacion %></td>
              <td><%= h.numero(p.hectareas) %> ha</td>
              <td><%= p.lotes %></td>
              <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-success" href="/productor/lotes/nuevo?parcela=<%= p.id %>" title="Crear lote aquí"><i class="bi bi-plus-lg"></i> Lote</a>
                <a class="btn btn-sm btn-outline-secondary" href="/productor/parcelas/<%= p.id %>/editar" aria-label="Editar <%= p.nombre %>"><i class="bi bi-pencil"></i></a>
                <form class="d-inline" method="post" action="/productor/parcelas/<%= p.id %>/eliminar" data-confirmar="¿Eliminar la parcela «<%= p.nombre %>»?">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Eliminar <%= p.nombre %>"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
