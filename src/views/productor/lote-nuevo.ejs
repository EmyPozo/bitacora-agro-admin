<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/productor/lotes">Lotes</a></li><li class="breadcrumb-item active">Nuevo</li></ol></nav>
<div class="card form-card">
  <div class="card-body p-4">
    <h1 class="h4 mb-1">Nuevo lote</h1>
    <p class="text-muted mb-4">El código del lote se genera solo.</p>
    <% if (!parcelas.length) { %>
      <div class="alert alert-warning">Primero necesitas una parcela. <a href="/productor/parcelas/nueva" class="alert-link">Crear parcela</a></div>
    <% } %>
    <form method="post" action="/productor/lotes" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="mb-3">
        <label class="form-label" for="parcela_id">Parcela</label>
        <select class="form-select<%= e.parcela_id ? ' is-invalid' : '' %>" id="parcela_id" name="parcela_id" required>
          <option value="">Selecciona una parcela...</option>
          <% parcelas.forEach(function (p) { %><option value="<%= p.id %>" <%= String(v.parcela_id) === String(p.id) ? 'selected' : '' %>><%= p.nombre %></option><% }) %>
        </select>
        <% if (e.parcela_id) { %><div class="invalid-feedback"><%= e.parcela_id %></div><% } %>
      </div>
      <div class="mb-3">
        <label class="form-label" for="cultivo_id">Cultivo</label>
        <select class="form-select<%= e.cultivo_id ? ' is-invalid' : '' %>" id="cultivo_id" name="cultivo_id" required>
          <option value="">Selecciona un cultivo...</option>
          <% cultivos.forEach(function (c) { %><option value="<%= c.id %>" <%= String(v.cultivo_id) === String(c.id) ? 'selected' : '' %>><%= c.nombre %> (ciclo aprox. <%= c.ciclo_dias %> días)</option><% }) %>
        </select>
        <% if (e.cultivo_id) { %><div class="invalid-feedback"><%= e.cultivo_id %></div><% } %>
      </div>
      <div class="mb-4">
        <label class="form-label" for="fecha_siembra">Fecha de siembra</label>
        <input type="date" class="form-control<%= e.fecha_siembra ? ' is-invalid' : '' %>" id="fecha_siembra" name="fecha_siembra" value="<%= v.fecha_siembra || '' %>" max="<%= hoy %>" required>
        <% if (e.fecha_siembra) { %><div class="invalid-feedback"><%= e.fecha_siembra %></div><% } %>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i> Crear lote</button>
        <a class="btn btn-outline-secondary" href="/productor/lotes">Cancelar</a>
      </div>
    </form>
  </div>
</div>
