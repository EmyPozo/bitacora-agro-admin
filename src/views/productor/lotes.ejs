<div class="encabezado">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-box-seam me-2 text-success"></i>Mis lotes</h1>
    <p class="text-muted mb-0">Cada lote es un cultivo sembrado en una de tus parcelas.</p>
  </div>
  <a class="btn btn-primary" href="/productor/lotes/nuevo"><i class="bi bi-plus-lg me-1"></i> Nuevo lote</a>
</div>

<ul class="nav nav-pills mb-3">
  <li class="nav-item"><a class="nav-link <%= estado === '' ? 'active' : '' %>" href="/productor/lotes">Todos</a></li>
  <li class="nav-item"><a class="nav-link <%= estado === 'ACTIVO' ? 'active' : '' %>" href="/productor/lotes?estado=ACTIVO">Activos</a></li>
  <li class="nav-item"><a class="nav-link <%= estado === 'COSECHADO' ? 'active' : '' %>" href="/productor/lotes?estado=COSECHADO">Cosechados</a></li>
</ul>

<div class="card">
  <% if (!lotes.length) { %>
    <div class="vacio"><i class="bi bi-inbox"></i><p class="mb-0">No hay lotes<%= estado ? ' con este estado' : ' todavía' %>.</p></div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Lote</th><th>Cultivo</th><th>Parcela</th><th>Siembra</th><th>Labores</th><th>Estado</th><th></th></tr></thead>
        <tbody>
          <% lotes.forEach(function (l) { %>
            <tr>
              <td class="fw-semibold"><a class="text-decoration-none" href="/productor/lotes/<%= l.id %>"><%= l.codigo %></a></td>
              <td><%= l.cultivo %></td>
              <td><%= l.parcela %></td>
              <td><%= h.fecha(l.fecha_siembra) %></td>
              <td><%= l.labores %></td>
              <td>
                <span class="badge text-bg-<%= l.estado === 'ACTIVO' ? 'success' : 'secondary' %>"><%= l.estado === 'ACTIVO' ? 'Activo' : 'Cosechado' %></span>
                <% if (l.certificado) { %><span class="badge text-bg-light border"><i class="bi bi-patch-check me-1"></i>Certificado</span><% } %>
              </td>
              <td class="text-end"><a class="btn btn-sm btn-outline-success" href="/productor/lotes/<%= l.id %>">Ver</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
