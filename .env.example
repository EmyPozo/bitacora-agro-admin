# Variables de entorno que usa la app. En local NO necesitas definir nada (hay valores por defecto).
# En Render se configuran en el panel (ver README). Este archivo solo documenta cuáles existen.
PORT=3000
NODE_ENV=development
# Obligatoria en producción: texto largo y aleatorio (mínimo 32 caracteres)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas
# Credenciales del administrador inicial (solo se usan la primera vez, cuando la base está vacía)
ADMIN_EMAIL=admin@bitacoraagro.com
ADMIN_PASSWORD=Admin123*
# Ruta del archivo SQLite (opcional)
# DATABASE_PATH=data/bitacora.db
